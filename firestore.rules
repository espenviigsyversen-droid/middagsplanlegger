rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedInVerified() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function memberDoc(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(myEmail());
    }

    function isMember(familyId) {
      return signedInVerified() && exists(memberDoc(familyId));
    }

    function isAdmin(familyId) {
      return isMember(familyId)
        && get(memberDoc(familyId)).data.role == 'admin';
    }

    match /families/{familyId} {

      match /members/{memberEmail} {
        allow read: if isMember(familyId);
        allow create: if isAdmin(familyId)
          && memberEmail == memberEmail.lower()
          && request.resource.data.role in ['admin', 'member'];
        allow update: if isAdmin(familyId)
          && memberEmail != myEmail()
          && request.resource.data.role in ['admin', 'member'];
        allow delete: if isAdmin(familyId)
          && memberEmail != myEmail();
      }

      match /app/{docId} {
        allow read: if isMember(familyId);
        allow write: if isMember(familyId)
          && (docId != 'meta' || isAdmin(familyId));
      }
      match /meals/{mealId} {
        allow read, write: if isMember(familyId);
      }
      match /weeks/{weekKey} {
        allow read, write: if isMember(familyId);
      }
      match /shoppingItems/{itemId} {
        allow read, write: if isMember(familyId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
